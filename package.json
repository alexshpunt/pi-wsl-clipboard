{
  "name": "pi-wsl-clipboard",
  "version": "0.2.0",
  "description": "Paste Windows clipboard text and images into Pi from WSL with Ctrl+V.",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "wsl",
    "clipboard",
    "windows",
    "paste"
  ],
  "author": "Aleksandr Shpuntenko",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check",
    "prepublishOnly": "npm run check",
    "pack:dry": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexshpunt/pi-wsl-clipboard.git"
  },
  "bugs": {
    "url": "https://github.com/alexshpunt/pi-wsl-clipboard/issues"
  },
  "homepage": "https://github.com/alexshpunt/pi-wsl-clipboard#readme",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
